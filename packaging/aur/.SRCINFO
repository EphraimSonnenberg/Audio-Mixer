	depends = python
	depends = python-gobject
	depends = python-cairo
	depends = gtk4
	depends = libadwaita
	depends = pipewire
	depends = libpulse
	depends = rnnoise
	optdepends = pipewire-pulse: PulseAudio compatibility (required on PipeWire systems)
	optdepends = ffmpeg: soundboard formats other than 16-bit WAV
	optdepends = fluidsynth: MIDI instrument channels
	optdepends = nvidia-utils: NVIDIA GPU stats on the deck
	optdepends = opendeck: control the mixer from a real Stream Deck
	provides = audio-mixer
	conflicts = audio-mixer
	source = audio-mixer::git+https://github.com/coolguy1333/Audio-Mixer.git
