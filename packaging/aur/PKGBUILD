# Maintainer: coolguy1333
pkgname=audio-mixer-git
_pkgname=audio-mixer
pkgver=r16.11961e3
pkgrel=1
pkgdesc="Wave Link style software audio mixer for PipeWire with a virtual Stream Deck, effects and soundboard"
arch=('x86_64' 'aarch64')
url="https://github.com/coolguy1333/Audio-Mixer"
license=('MIT')
depends=(
  'python'
  'python-gobject'
  'python-cairo'
  'gtk4'
  'libadwaita'
  'pipewire'
  'libpulse'
  'rnnoise'
)
makedepends=('git' 'gcc')
optdepends=(
  'pipewire-pulse: PulseAudio compatibility (required on PipeWire systems)'
  'ffmpeg: soundboard formats other than 16-bit WAV'
  'fluidsynth: MIDI instrument channels'
  'nvidia-utils: NVIDIA GPU stats on the deck'
  'opendeck: control the mixer from a real Stream Deck'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
install=audio-mixer-git.install
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd "$_pkgname"
  ${CC:-gcc} $CFLAGS $LDFLAGS -fPIC -shared -o fx/amx_fx.so fx/amx_fx.c -lrnnoise -lm
}

package() {
  cd "$_pkgname"
  local dest="$pkgdir/usr/share/$_pkgname"

  install -Dm644 -t "$dest" audio_mixer.py amx_effects.py amx_extras.py
  chmod 755 "$dest/audio_mixer.py"
  install -Dm644 -t "$dest/fx" fx/amx_fx.c
  install -Dm755 -t "$dest/fx" fx/amx_fx.so
  # keep the .so newer than its source so the app never tries to rebuild it
  touch -r fx/amx_fx.c "$dest/fx/amx_fx.c"
  install -Dm644 -t "$dest/web" web/companion.html
  install -Dm644 -t "$dest/assets/icons/hicolor/scalable/actions" \
    assets/icons/hicolor/scalable/actions/*.svg
  cp -r --no-preserve=ownership opendeck "$dest/"
  rm -rf "$dest"/opendeck/*/__pycache__

  python -m compileall -q -d "/usr/share/$_pkgname" "$dest"/*.py

  install -dm755 "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/$_pkgname" <<'SH'
#!/bin/sh
exec python3 /usr/share/audio-mixer/audio_mixer.py "$@"
SH
  chmod 755 "$pkgdir/usr/bin/$_pkgname"

  install -Dm644 packaging/io.github.lawsonf.AudioMixer.desktop \
    "$pkgdir/usr/share/applications/io.github.lawsonf.AudioMixer.desktop"
  install -Dm644 assets/io.github.lawsonf.AudioMixer.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.lawsonf.AudioMixer.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$_pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
